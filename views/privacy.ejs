            font-size: 1.3rem;
        }
    }
</style>

<script>
    // Поддержка тёмной темы для этой страницы
    (function() {
        const darkTheme = document.getElementById('darkTheme');
        if (darkTheme && !darkTheme.disabled) {
            document.body.classList.add('dark');
        }
        
        // Следим за изменениями темы
        const observer = new MutationObserver(function() {
            const darkThemeElem = document.getElementById('darkTheme');
            if (darkThemeElem && !darkThemeElem.disabled) {
                document.body.classList.add('dark');
            } else {
                document.body.classList.remove('dark');
            }
        });
        
        const darkThemeElem = document.getElementById('darkTheme');
        if (darkThemeElem) {
            observer.observe(darkThemeElem, { attributes: true, attributeFilter: ['disabled'] });
        }
    })();
</script>

