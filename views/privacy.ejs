    }
    
    .privacy-section h2 {
        color: #2c3e50;
        font-size: 1.4rem;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 3px solid #967BB6;
        display: inline-block;
    }
    
    .privacy-section p {
        color: #555;
        line-height: 1.7;
        margin-bottom: 12px;
    }
    
    .privacy-section ul {
        margin-left: 25px;
        margin-top: 10px;
        margin-bottom: 15px;
    }
    
    .privacy-section li {
        color: #555;
        line-height: 1.7;
        margin-bottom: 8px;
    }
    
    .privacy-email, .privacy-phone {
        color: #967BB6;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }
    
    .privacy-email:hover, .privacy-phone:hover {
        color: #7B5EA7;
        text-decoration: underline;
    }
    
    .privacy-footer {
        background: #f8f9fa;
        padding: 20px;
        text-align: center;
        border-top: 1px solid #ecf0f1;
        color: #95a5a6;
        font-size: 14px;
    }
    
    /* Тёмная тема */
    body.dark .privacy-container {
        background: #1e1e1e;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }
    
    body.dark .privacy-title {
        background: #24332e;
    }
    
    body.dark .privacy-date {
        background: #2a2a2a;
        color: #aaa;
        border-bottom-color: #333;
    }
    
    body.dark .privacy-section h2 {
        color: #967BB6;
        border-bottom-color: #967BB6;
    }
    
    body.dark .privacy-section p,
    body.dark .privacy-section li {
        color: #ccc;
    }
    
    body.dark .privacy-email, body.dark .privacy-phone {
        color: #967BB6;
    }
    
    body.dark .privacy-email:hover, body.dark .privacy-phone:hover {
        color: #7B5EA7;
    }
    
    body.dark .privacy-footer {
        background: #2a2a2a;
        border-top-color: #333;
        color: #777;
    }
    
    /* Адаптивность для телефонов */
