<%- include('partials/header') %>

<main>
    <div class="container">
        <h1>Галерея работ</h1>
        
        <!-- Фильтры -->
        <div class="filters">
            <h3>Фильтр по категориям</h3>
            <form method="GET" action="/gallery">
                <div class="filter-group">
                    <select name="style">
                        <option value="">Все стили</option>
                        <option value="Реализм" <%= filters.style === 'Реализм' ? 'selected' : '' %>>Реализм</option>
                        <option value="Импрессионизм" <%= filters.style === 'Импрессионизм' ? 'selected' : '' %>>Импрессионизм</option>
                        <option value="Абстракционизм" <%= filters.style === 'Абстракционизм' ? 'selected' : '' %>>Абстракционизм</option>
                        <option value="Сюрреализм" <%= filters.style === 'Сюрреализм' ? 'selected' : '' %>>Сюрреализм</option>
                        <option value="Классицизм" <%= filters.style === 'Классицизм' ? 'selected' : '' %>>Классицизм</option>
                        <option value="Барокко" <%= filters.style === 'Барокко' ? 'selected' : '' %>>Барокко</option>
                        <option value="Ренессанс" <%= filters.style === 'Ренессанс' ? 'selected' : '' %>>Ренессанс</option>
                        <option value="Модерн" <%= filters.style === 'Модерн' ? 'selected' : '' %>>Модерн</option>
                        <option value="Экспрессионизм" <%= filters.style === 'Экспрессионизм' ? 'selected' : '' %>>Экспрессионизм</option>
                        <option value="Кубизм" <%= filters.style === 'Кубизм' ? 'selected' : '' %>>Кубизм</option>
                    </select>
                    
                    <select name="technique">
                        <option value="">Все техники</option>
                        <option value="Масло" <%= filters.technique === 'Масло' ? 'selected' : '' %>>Масло</option>
                        <option value="Акварель" <%= filters.technique === 'Акварель' ? 'selected' : '' %>>Акварель</option>
                        <option value="Акрил" <%= filters.technique === 'Акрил' ? 'selected' : '' %>>Акрил</option>
                        <option value="Гуашь" <%= filters.technique === 'Гуашь' ? 'selected' : '' %>>Гуашь</option>
                        <option value="Пастель" <%= filters.technique === 'Пастель' ? 'selected' : '' %>>Пастель</option>
                        <option value="Карандаш" <%= filters.technique === 'Карандаш' ? 'selected' : '' %>>Карандаш</option>
                        <option value="Тушь" <%= filters.technique === 'Тушь' ? 'selected' : '' %>>Тушь</option>
                        <option value="Цифровая живопись" <%= filters.technique === 'Цифровая живопись' ? 'selected' : '' %>>Цифровая живопись</option>
                    </select>
                    
                    <select name="mood">
                        <option value="">Все настроения</option>
                        <option value="Спокойствие" <%= filters.mood === 'Спокойствие' ? 'selected' : '' %>>Спокойствие</option>
                        <option value="Энергия" <%= filters.mood === 'Энергия' ? 'selected' : '' %>>Энергия</option>
                        <option value="Меланхолия" <%= filters.mood === 'Меланхолия' ? 'selected' : '' %>>Меланхолия</option>
                        <option value="Радость" <%= filters.mood === 'Радость' ? 'selected' : '' %>>Радость</option>
                        <option value="Таинственность" <%= filters.mood === 'Таинственность' ? 'selected' : '' %>>Таинственность</option>
                        <option value="Вдохновение" <%= filters.mood === 'Вдохновение' ? 'selected' : '' %>>Вдохновение</option>
                        <option value="Тоска" <%= filters.mood === 'Тоска' ? 'selected' : '' %>>Тоска</option>
                        <option value="Романтика" <%= filters.mood === 'Романтика' ? 'selected' : '' %>>Романтика</option>
                        <option value="Тревога" <%= filters.mood === 'Тревога' ? 'selected' : '' %>>Тревога</option>
                    </select>
                    
                    <input type="text" name="artist" placeholder="Поиск по художнику" value="<%= filters.artist || '' %>">
                    
                    <button type="submit">🔍 Применить фильтр</button>
                    <a href="/gallery" class="btn-small">Сбросить</a>
                </div>
            </form>
        </div>
        
        <!-- Список картин -->
        <div class="painting-grid">
            <% if (paintings && paintings.length > 0) { %>
                <% paintings.forEach(painting => { %>
                    <div class="painting-card" onclick="openModal(<%= painting.id %>, '<%= painting.title.replace(/'/g, "\\'") %>', '<%= painting.image_url %>', '<%= painting.artist ? painting.artist.replace(/'/g, "\\'") : "" %>', '<%= painting.description ? painting.description.replace(/'/g, "\\'") : "" %>', <%= painting.views || 0 %>, <%= painting.likes || 0 %>)">
                        <img src="<%= painting.image_url || '/images/placeholder.jpg' %>" alt="<%= painting.title %>">
                        <div class="painting-info">
                            <h3><%= painting.title %></h3>
                            <p><%= painting.artist || 'Неизвестный художник' %></p>
                            <p><small><%= painting.style || '' %> <%= painting.year ? painting.year : '' %></small></p>
                            <div style="display: flex; gap: 10px; margin-top: 10px;">
                                <span>👁️ <%= painting.views || 0 %></span>
                                <span>❤️ <span id="likes-<%= painting.id %>"><%= painting.likes || 0 %></span></span>
                                <button onclick="event.stopPropagation(); likePainting(<%= painting.id %>)" style="background: none; border: none; cursor: pointer; color: #e74c3c;">👍</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Пока нет картин в галерее. Добавьте первую!</p>
            <% } %>
        </div>
        
        <% if (user) { %>
            <div style="text-align: center; margin-top: 2rem;">
                <a href="/add-painting" class="btn-primary">➕ Добавить картину</a>
            </div>
        <% } %>
    </div>
</main>

<!-- МОДАЛЬНОЕ ОКНО (всегда светлое) -->
<div id="modal" class="modal" onclick="closeModalOnBackground(event)">
    <div class="modal-content">
        <button class="modal-close" onclick="closeModal()">✖ Закрыть</button>
        <img id="modalImage" src="">
        <div class="modal-info">
            <h2 id="modalTitle"></h2>
            <p id="modalArtist"></p>
            <p id="modalDescription"></p>
            <div style="display: flex; gap: 20px; margin-top: 15px;">
                <span>👁️ Просмотров: <span id="modalViews">0</span></span>
                <span>❤️ Лайков: <span id="modalLikes">0</span></span>
                <button onclick="likePaintingFromModal()" style="background: #967BB6; color: white; border: none; padding: 5px 15px; border-radius: 5px; cursor: pointer;">👍 Нравится</button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<style>
    /* Модальное окно - ФИКСИРОВАННОЕ В СВЕТЛОЙ ТЕМЕ */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.95);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }
    
    .modal.active {
        display: flex;
    }
    
    .modal-content {
        max-width: 90%;
        max-height: 90%;
        background: white !important;
        border-radius: 10px;
        overflow: auto;
        position: relative;
        cursor: default;
        color: #333 !important;
    }
    
    /* Принудительные светлые стили для всего содержимого модального окна */
    .modal-content * {
        color: #333 !important;
    }
    
    .modal-content h2,
    .modal-content p,
    .modal-content span,
    .modal-content strong {
        color: #333 !important;
    }
    
    .modal-info {
        padding: 20px;
        background: white !important;
    }
    
    .modal-content img {
        width: 100%;
        max-height: 60vh;
        object-fit: contain;
    }
    
    .modal-close {
        position: absolute;
        top: 10px;
        right: 15px;
        background: #967BB6;
        color: white !important;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        z-index: 10;
    }
    
    .modal-close:hover {
        background: #7B5EA7;
    }
    
    .modal-info button {
        color: white !important;
        background: #967BB6 !important;
    }
    
    .modal-info button:hover {
        background: #7B5EA7 !important;
    }
    
    .painting-card {
        cursor: pointer;
    }
</style>

<script>
    // Модальное окно
    let currentPaintingId = null;
    
    function openModal(id, title, imageUrl, artist, description, views, likes) {
        currentPaintingId = id;
        document.getElementById('modalImage').src = imageUrl || '/images/placeholder.jpg';
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalArtist').innerHTML = `<strong>Художник:</strong> ${artist || 'Неизвестен'}`;
        document.getElementById('modalDescription').innerHTML = description || 'Описание отсутствует';
        document.getElementById('modalViews').innerText = views;
        document.getElementById('modalLikes').innerText = likes;
        document.getElementById('modal').classList.add('active');
        document.body.style.overflow = 'hidden';
        
        fetch(`/painting/${id}/view`, { method: 'POST' })
            .then(() => {
                document.getElementById('modalViews').innerText = parseInt(document.getElementById('modalViews').innerText) + 1;
            });
    }
    
    function closeModal() {
        document.getElementById('modal').classList.remove('active');
        document.body.style.overflow = '';
        currentPaintingId = null;
    }
    
    function closeModalOnBackground(event) {
        if (event.target === document.getElementById('modal')) {
            closeModal();
        }
    }
    
    function likePainting(id) {
        fetch(`/painting/${id}/like`, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const likesSpan = document.getElementById(`likes-${id}`);
                    if (likesSpan) likesSpan.innerText = data.likes;
                    if (currentPaintingId === id) {
                        document.getElementById('modalLikes').innerText = data.likes;
                    }
                }
            });
    }
    
    function likePaintingFromModal() {
        if (currentPaintingId) {
            likePainting(currentPaintingId);
        }
    }
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });
</script>