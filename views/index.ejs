<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>World of Paintings - Мир живописи</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Стили для слайдера */
        .slider-container {
            position: relative;
            max-width: 100%;
            margin: 2rem 0;
            overflow: hidden;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.2);
        }
        
        .slider {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }
        
        .slide {
            min-width: 100%;
            position: relative;
            height: 500px;
        }
        
        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .slide-caption {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            color: white;
            padding: 2rem;
            text-align: center;
        }
        
        .slide-caption h3 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }
        
        .prev, .next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.5);
            color: white;
            padding: 1rem;
            cursor: pointer;
            border: none;
            font-size: 1.5rem;
            z-index: 10;
        }
        
        .prev { left: 0; }
        .next { right: 0; }
        
        .prev:hover, .next:hover {
            background: rgba(0,0,0,0.8);
        }
        
        .dots {
            text-align: center;
            padding: 1rem;
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 10;
        }
        
        .dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.5);
            margin: 0 5px;
            cursor: pointer;
        }
        
        .dot.active {
            background: white;
        }
        
        .section-title {
            text-align: center;
            margin: 3rem 0 1.5rem;
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: #2c3e50;
        }
        
        /* Модальное окно */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.95);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            max-width: 90%;
            max-height: 90%;
            background: white;
            border-radius: 10px;
            overflow: auto;
            position: relative;
            cursor: default;
        }
        
        .modal-content img {
            width: 100%;
            max-height: 60vh;
            object-fit: contain;
        }
        
        .modal-info {
            padding: 20px;
        }
        
        .modal-close {
            position: absolute;
            top: 10px;
            right: 15px;
            background: #e74c3c;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            z-index: 10;
        }
        
        @media (max-width: 768px) {
            .slide {
                height: 300px;
            }
            
            .slide-caption h3 {
                font-size: 1.2rem;
            }
            
            .modal-content {
                max-width: 95%;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <div class="container">
            <!-- СЛАЙДЕР -->
            <% if (popularPaintings && popularPaintings.length > 0) { %>
            <div class="slider-container">
                <button class="prev" onclick="changeSlide(-1)">❮</button>
                <div class="slider" id="slider">
                    <% popularPaintings.forEach((painting, index) => { %>
                        <div class="slide">
                            <img src="<%= painting.image_url || '/images/placeholder.jpg' %>" alt="<%= painting.title %>">
                            <div class="slide-caption">
                                <h3><%= painting.title %></h3>
                                <p><%= painting.artist || 'Неизвестный художник' %></p>
                                <a href="/painting/<%= painting.id %>" class="btn-small">Подробнее</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <button class="next" onclick="changeSlide(1)">❯</button>
                <div class="dots" id="dots"></div>
            </div>
            <% } %>
            
            <!-- ПОПУЛЯРНЫЕ КАРТИНЫ -->
            <h2 class="section-title">🎨 Популярные картины</h2>
            <div class="painting-grid">
                <% if (popularPaintings && popularPaintings.length > 0) { %>
                    <% popularPaintings.slice(0, 4).forEach(painting => { %>
                        <div class="painting-card" onclick="openModal(<%= painting.id %>, '<%= painting.title %>', '<%= painting.image_url %>', '<%= painting.artist %>', '<%= painting.description %>', <%= painting.views || 0 %>, <%= painting.likes || 0 %>)">
                            <img src="<%= painting.image_url || '/images/placeholder.jpg' %>" alt="<%= painting.title %>">
                            <div class="painting-info">
                                <h3><%= painting.title %></h3>
                                <p><%= painting.artist || 'Неизвестный художник' %></p>
                                <div style="display: flex; gap: 10px; margin-top: 10px;">
                                    <span>👁️ <%= painting.views || 0 %></span>
                                    <span>❤️ <span id="likes-<%= painting.id %>"><%= painting.likes || 0 %></span></span>
                                    <button onclick="event.stopPropagation(); likePainting(<%= painting.id %>)" style="background: none; border: none; cursor: pointer; color: #e74c3c;">👍</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Пока нет картин</p>
                <% } %>
            </div>
            
            <!-- НОВОСТИ -->
            <h2 class="section-title">📰 Последние новости</h2>
            <div class="painting-grid">
                <% if (news && news.length > 0) { %>
                    <% news.forEach(item => { %>
                        <div class="painting-card">
                            <div class="painting-info">
                                <h3><%= item.title %></h3>
                                <p><%= item.content %></p>
                                <small><%= new Date(item.created_at).toLocaleDateString('ru-RU') %></small>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Новостей пока нет</p>
                <% } %>
            </div>
        </div>
    </main>

    <!-- МОДАЛЬНОЕ ОКНО -->
    <div id="modal" class="modal" onclick="closeModalOnBackground(event)">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal()">✖ Закрыть</button>
            <img id="modalImage" src="">
            <div class="modal-info">
                <h2 id="modalTitle"></h2>
                <p id="modalArtist"></p>
                <p id="modalDescription"></p>
                <div style="display: flex; gap: 20px; margin-top: 15px;">
                    <span>👁️ Просмотров: <span id="modalViews">0</span></span>
                    <span>❤️ Лайков: <span id="modalLikes">0</span></span>
                    <button onclick="likePaintingFromModal()" style="background: #e74c3c; color: white; border: none; padding: 5px 15px; border-radius: 5px; cursor: pointer;">👍 Нравится</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        // Слайдер
        let slideIndex = 0;
        const slides = document.querySelectorAll('.slide');
        
        function showSlides() {
            if (!slides.length) return;
            const slider = document.getElementById('slider');
            if (slider) slider.style.transform = `translateX(-${slideIndex * 100}%)`;
            
            document.querySelectorAll('.dot').forEach((dot, i) => {
                dot.classList.toggle('active', i === slideIndex);
            });
        }
        
        function changeSlide(n) {
            slideIndex = (slideIndex + n + slides.length) % slides.length;
            showSlides();
        }
        
        function createDots() {
            const dotsContainer = document.getElementById('dots');
            if (!dotsContainer) return;
            slides.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = 'dot' + (i === slideIndex ? ' active' : '');
                dot.onclick = () => { slideIndex = i; showSlides(); };
                dotsContainer.appendChild(dot);
            });
        }
        
        let autoSlide = setInterval(() => changeSlide(1), 5000);
        const sliderContainer = document.querySelector('.slider-container');
        if (sliderContainer) {
            sliderContainer.addEventListener('mouseenter', () => clearInterval(autoSlide));
            sliderContainer.addEventListener('mouseleave', () => {
                autoSlide = setInterval(() => changeSlide(1), 5000);
            });
        }
        
        // Модальное окно
        let currentPaintingId = null;
        
        function openModal(id, title, imageUrl, artist, description, views, likes) {
            currentPaintingId = id;
            document.getElementById('modalImage').src = imageUrl || '/images/placeholder.jpg';
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalArtist').innerHTML = `<strong>Художник:</strong> ${artist || 'Неизвестен'}`;
            document.getElementById('modalDescription').innerHTML = description || 'Описание отсутствует';
            document.getElementById('modalViews').innerText = views;
            document.getElementById('modalLikes').innerText = likes;
            document.getElementById('modal').classList.add('active');
            document.body.style.overflow = 'hidden';
            
            fetch(`/painting/${id}/view`, { method: 'POST' })
                .then(() => {
                    document.getElementById('modalViews').innerText = parseInt(document.getElementById('modalViews').innerText) + 1;
                });
        }
        
        function closeModal() {
            document.getElementById('modal').classList.remove('active');
            document.body.style.overflow = '';
            currentPaintingId = null;
        }
        
        function closeModalOnBackground(event) {
            if (event.target === document.getElementById('modal')) {
                closeModal();
            }
        }
        
        function likePainting(id) {
            fetch(`/painting/${id}/like`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const likesSpan = document.getElementById(`likes-${id}`);
                        if (likesSpan) likesSpan.innerText = data.likes;
                        if (currentPaintingId === id) {
                            document.getElementById('modalLikes').innerText = data.likes;
                        }
                    }
                });
        }
        
        function likePaintingFromModal() {
            if (currentPaintingId) {
                likePainting(currentPaintingId);
            }
        }
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
        
        createDots();
        showSlides();
    </script>
</body>
</html>